<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;wwwroot/lib/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <Content Remove="package*.json;Styles/**;wwwroot/js/**;wwwroot/favicon.ico;wwwroot/css/site.css" />
    <Content Include="wwwroot/css/site.css" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildStyles" BeforeTargets="BeforeBuild" Condition="'$(BuildFrontend)' != 'false'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('node_modules')" />
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
