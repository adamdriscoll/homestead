<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;wwwroot/lib/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The public Razor language API compiles trusted templates without an SDK at runtime. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.2" />
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <Content Remove="package*.json;Styles/**;wwwroot/js/site.js;wwwroot/favicon.ico;wwwroot/css/site.css" />
    <Content Include="wwwroot/css/site.css" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Themes/**" />
    <Content Include="Themes/**" Exclude="Themes/**/*.razor" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Themes/**/*.razor" />
    <None Include="Themes/**/*.razor" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Maps/**" />
    <Content Include="Maps/location-map.js;Maps/fitness-map.js;Maps/leaflet/leaflet.js;Maps/leaflet/leaflet.css;Maps/leaflet/LICENSE.txt;Maps/leaflet/images/marker-icon.png;Maps/leaflet/images/marker-icon-2x.png;Maps/leaflet/images/marker-shadow.png;Maps/leaflet/images/layers.png;Maps/leaflet/images/layers-2x.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="wwwroot/icons/**" />
    <Content Include="wwwroot/icons/toolbar.svg;wwwroot/icons/LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Theme sources are compiled by the theme engine with its model and imports. -->
  <Target Name="ExcludeThemeComponents" AfterTargets="ResolveRazorComponentInputs">
    <ItemGroup>
      <RazorComponent Remove="Themes/**/*.razor" />
    </ItemGroup>
  </Target>
  <Target Name="BuildStyles" BeforeTargets="BeforeBuild" Condition="'$(BuildFrontend)' != 'false'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('node_modules')" />
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
