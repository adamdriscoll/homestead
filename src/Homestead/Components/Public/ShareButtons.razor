@if (Links.Length > 0)
{
    <nav aria-label="Share post" class="flex flex-wrap items-center gap-2" data-social-sharing>
        @foreach (var link in Links)
        {
            <a class="btn btn-ghost btn-square border-0 shadow-none min-h-11 min-w-11" href="@link.Url" rel="noreferrer" title="@($"Share via {link.Label}")" aria-label="@($"Share via {link.Label}")">@((MarkupString)SocialSharing.RenderIcon(link.Label))</a>
        }
    </nav>
}
@code {
    [Parameter, EditorRequired] public Homestead.Features.Themes.ThemeLinkModel[] Links { get; set; } = [];
}
