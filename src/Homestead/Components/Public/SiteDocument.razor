@using Homestead.Features.Settings
@using Homestead.Data.Entities
@inject SafeMarkdown Markdown
<html lang="en" data-accent="@Page.Settings.AccentColor.ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title</title>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@Canonical" />
    <link rel="alternate" type="application/rss+xml" title="@Page.Settings.Title" href="@Absolute("/rss.xml")" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Canonical" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:type" content="@(Page.Article is null ? "website" : "article")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    <meta name="twitter:image" content="@SocialImage" />
    @if (Page.Preview) { <meta name="robots" content="noindex, nofollow" /> }
    <link rel="stylesheet" href="@(Page.Preview ? "/css/site.css" : "/assets/site.css")" />
</head>
<body>
    <a href="#main" class="btn absolute -top-20 focus:top-2 left-2">Skip to content</a>
    <header class="max-w-3xl mx-auto px-4 py-8 border-b border-base-300 space-y-4">
        @if (Brand(Page.Settings.HeaderMediaId) is { } header)
        { <img src="@ImageUrl(header)" alt="" class="w-full max-h-64 object-cover rounded-lg" /> }
        <div class="flex items-center gap-4">
            @if (Brand(Page.Settings.LogoMediaId) is { } logo)
            { <img src="@ImageUrl(logo)" alt="" class="max-w-24 max-h-16 object-contain" /> }
            <a href="/" class="text-2xl font-semibold break-words">@Page.Settings.Title</a>
        </div>
        <p>@Page.Settings.Description</p>
        <nav aria-label="Main navigation" class="flex flex-wrap gap-1">
            @foreach (var (path, label) in Navigation)
            { <a class="btn min-h-11" href="@path" aria-current="@(Page.Path == path ? "page" : null)">@label</a> }
        </nav>
    </header>
    <main id="main" class="max-w-3xl mx-auto px-4 py-8 space-y-6">
        @if (Page.Preview) { <p class="alert" role="status">Private draft preview · unpublished edits</p> }
        @if (Page.Article is { } article)
        {
            <article class="space-y-6">
                <h1 class="text-4xl font-semibold break-words">@article.DisplayTitle</h1>
                <p>@Page.Settings.DisplayAuthor · @(article.Type == PostType.Microblog ? "Note" : article.Type.ToString()) · <time datetime="@article.PublishedAtUtc.ToString("O")">@Date(article)</time></p>
                <PostContent Post="article" Preview="Page.Preview" />
                @Tags(article)
            </article>
        }
        else if (Page.Path == "/about/")
        {
            <h1 class="text-3xl font-semibold">About @Page.Settings.DisplayAuthor</h1>
            @if (Brand(Page.Settings.AvatarMediaId) is { } avatar)
            { <img src="@ImageUrl(avatar)" alt="@Page.Settings.DisplayAuthor" class="w-24 h-24 rounded-full object-cover" /> }
            <p>@Page.Settings.AuthorBio</p>
            @if (string.IsNullOrWhiteSpace(Page.Settings.AboutMarkdown)) { <p>More about this homestead soon.</p> }
            else { <div class="prose-content">@((MarkupString)Markdown.Render(About, Page.Preview))</div> }
        }
        else
        {
            <h1 class="text-3xl font-semibold">@Page.Heading</h1>
            @if (Page.Articles.Length == 0) { <p>No posts here yet. Come back soon, or explore <a class="underline" href="/">the home feed</a>.</p> }
            @foreach (var post in Page.Articles)
            {
                <article class="card border border-base-300">
                    <div class="card-body">
                        <p class="text-sm">@(post.Type == PostType.Microblog ? "Note" : post.Type.ToString()) · <time datetime="@post.PublishedAtUtc.ToString("O")">@Date(post)</time></p>
                        <h2 class="card-title break-words"><a href="@($"/posts/{post.Slug}/")">@post.DisplayTitle</a></h2>
                        @if (post.Type == PostType.Microblog) { <PostContent Post="post" /> }
                        else
                        {
                            @if (post.Type == PostType.Review && post.Review is { } review)
                            { <p><strong>@review.Subject</strong> · @review.Rating/5</p> }
                            @if (post.Type == PostType.Guide) { <p>@post.Steps.Length steps</p> }
                            @if (post.Type == PostType.Gallery) { <p>@post.Media.Length photos</p> }
                            @if ((post.Media.SingleOrDefault(x => x.Id == post.CoverMediaId) ?? (post.Type == PostType.Article ? null : post.Media.FirstOrDefault())) is { } cover)
                            { <img src="@cover.Url" alt="@cover.AltText" class="w-full max-h-80 object-cover rounded-lg" loading="lazy" /> }
                            <p>@DiscoveryFiles.Description(post)</p>
                        }
                        @Tags(post)
                    </div>
                </article>
            }
        }
    </main>
    <footer class="max-w-3xl mx-auto p-4 border-t border-base-300 space-y-4">
        <p>@Page.Settings.FooterText</p>
        <nav aria-label="External profiles" class="flex flex-wrap gap-4">
            @foreach (var profile in Page.Settings.ProfileLinks)
            { <a class="underline py-3 break-words" href="@profile.Url" rel="me noopener noreferrer">@profile.Label</a> }
            <a class="underline py-3" href="/rss.xml">RSS feed</a>
        </nav>
    </footer>
</body>
</html>
@code {
    [Parameter, EditorRequired] public PublicPage Page { get; set; } = null!;
    private static readonly (string, string)[] Navigation = [("/", "Home"), ("/notes/", "Notes"), ("/articles/", "Articles"),
        ("/reviews/", "Reviews"), ("/guides/", "Guides"), ("/galleries/", "Galleries"), ("/about/", "About")];
    private string Title => Page.Article is { } post ? $"{post.DisplayTitle} · {Page.Settings.Title}"
        : Page.Path == "/" ? Page.Settings.Title : $"{Page.Heading} · {Page.Settings.Title}";
    private string Description => Page.Article is { } post ? DiscoveryFiles.Description(post)
        : Page.Path == "/about/" && !string.IsNullOrWhiteSpace(Page.Settings.AuthorBio) ? Page.Settings.AuthorBio : DiscoveryFiles.SiteDescription(Page.Settings);
    private string Absolute(string path) => DiscoveryFiles.Absolute(Page.Settings, path);
    private string Canonical => Absolute(Page.Article is { } post ? $"/posts/{post.Slug}/" : Page.Path);
    private string SocialImage => Absolute((Page.Article?.Media.SingleOrDefault(x => x.Id == Page.Article.CoverMediaId)
        ?? Page.Article?.Media.FirstOrDefault() ?? Brand(Page.Settings.HeaderMediaId) ?? Brand(Page.Settings.AvatarMediaId)
        ?? Brand(Page.Settings.LogoMediaId))?.Url ?? "/assets/social-default.png");
    private ArticleMedia? Brand(Guid? id) => Page.Branding?.SingleOrDefault(x => x.Id == id);
    private string ImageUrl(ArticleMedia image) => Page.Preview ? image.PrivateUrl : image.Url;
    private string Date(ArticleSnapshot post) => TimeZoneInfo.ConvertTimeFromUtc(post.PublishedAtUtc,
        TimeZoneInfo.FindSystemTimeZoneById(Page.Settings.TimeZone)).ToString("MMMM d, yyyy");
    private ArticleSnapshot About => new(1, Guid.Empty, "about", "About", Page.Settings.AboutMarkdown, null,
        DateTime.UtcNow, DateTime.UtcNow, 0, [], null, Page.Branding ?? []);
    private RenderFragment Tags(ArticleSnapshot post) => @<nav aria-label="Post tags" class="flex flex-wrap gap-3">
        @foreach (var tag in post.Tags) { <a class="underline py-2" href="@($"/tags/{post.TagSlug(tag)}/")">@tag</a> }
    </nav>;
}
