@inject SafeMarkdown Markdown
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(Page.Article is null ? Page.Settings.Title : $"{Page.Article.Title} · {Page.Settings.Title}")</title>
    <meta name="description" content="@(Page.Article?.Summary ?? Page.Settings.Description)" />
    <link rel="canonical" href="@(Page.Settings.CanonicalBaseUrl + (Page.Article is null ? "/" : $"/posts/{Page.Article.Slug}/"))" />
    @if (Page.Preview) { <meta name="robots" content="noindex, nofollow" /> }
    <link rel="stylesheet" href="@(Page.Preview ? "/css/site.css" : "/assets/site.css")" />
</head>
<body>
    <a href="#main" class="btn absolute -top-20 focus:top-2 left-2">Skip to content</a>
    <header class="max-w-3xl mx-auto px-4 py-8 border-b border-base-300">
        <a href="/" class="text-2xl font-semibold">@Page.Settings.Title</a>
        <p class="mt-2">@Page.Settings.Description</p>
    </header>
    <main id="main" class="max-w-3xl mx-auto px-4 py-8 space-y-6">
        @if (Page.Preview) { <p class="alert" role="status">Private draft preview · unpublished edits</p> }
        @if (Page.Article is { } article)
        {
            <article class="space-y-6">
                <h1 class="text-4xl font-semibold break-words">@(string.IsNullOrWhiteSpace(article.Title) ? "Untitled article" : article.Title)</h1>
                <p>@Page.Settings.DisplayAuthor · <time datetime="@article.PublishedAtUtc.ToString("O")">@TimeZoneInfo.ConvertTimeFromUtc(article.PublishedAtUtc, TimeZoneInfo.FindSystemTimeZoneById(Page.Settings.TimeZone)).ToString("MMMM d, yyyy")</time></p>
                @if (article.Summary is { Length: > 0 }) { <p class="text-xl">@article.Summary</p> }
                @if (article.Media.SingleOrDefault(x => x.Id == article.CoverMediaId) is { } cover)
                { <img src="@(Page.Preview ? cover.PrivateUrl : cover.Url)" alt="@cover.AltText" class="w-full rounded-lg" /> }
                <div class="[&_h1]:text-3xl [&_h2]:text-2xl [&_h3]:text-xl [&_h1]:font-semibold [&_h2]:font-semibold [&_h3]:font-semibold [&_p]:my-4 [&_h2]:my-6 [&_h3]:my-4 [&_a]:underline [&_ul]:list-disc [&_ol]:list-decimal [&_ul]:pl-6 [&_ol]:pl-6 [&_blockquote]:border-l-4 [&_blockquote]:border-base-300 [&_blockquote]:pl-4 [&_pre]:overflow-x-auto [&_pre]:bg-base-200 [&_pre]:p-4 [&_img]:max-w-full [&_img]:rounded-lg break-words">@((MarkupString)Markdown.Render(article, Page.Preview))</div>
                @if (article.Tags.Length > 0) { <p class="text-sm">@string.Join(" · ", article.Tags)</p> }
            </article>
        }
        else
        {
            <h1 class="text-3xl font-semibold">Welcome home.</h1>
            @if (Page.Articles.Length == 0) { <p>Stories will appear here soon.</p> }
            @foreach (var post in Page.Articles)
            {
                <article class="border-b border-base-300 py-6 space-y-2">
                    <h2 class="text-2xl font-semibold"><a href="@($"/posts/{post.Slug}/")">@post.Title</a></h2>
                    <p>@post.Summary</p>
                </article>
            }
        }
    </main>
    <footer class="max-w-3xl mx-auto p-4 border-t border-base-300">@Page.Settings.FooterText</footer>
</body>
</html>
@code { [Parameter, EditorRequired] public PublicPage Page { get; set; } = null!; }
