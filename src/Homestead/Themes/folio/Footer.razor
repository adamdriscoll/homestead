<footer data-folio-footer>
    <div>
        <a data-folio-wordmark href="/">@Model.Site.Title<span aria-hidden="true">.</span></a>
        @if (!string.IsNullOrWhiteSpace(Model.Site.FooterText)) { <p>@Model.Site.FooterText</p> }
        <p>Published by @Model.Site.DisplayAuthor</p>
    </div>
    <nav aria-label="External profiles">
        @foreach (var profile in Model.Site.ProfileLinks)
        {
            <a class="link" href="@profile.Url" rel="me noopener noreferrer">@profile.Label</a>
        }
        <a class="link" href="/rss.xml">RSS feed</a>
    </nav>
    @if (!Model.Site.HideHomesteadCredit)
    {
        <p data-folio-credit>Made at home with <a class="link" href="https://github.com/PoshTools/homestead">Homestead</a></p>
    }
</footer>
