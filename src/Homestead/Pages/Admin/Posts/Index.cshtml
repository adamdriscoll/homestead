@page "/admin/posts"
@model Homestead.Pages.Admin.Posts.IndexModel
@{ ViewData["Title"] = "Posts"; }
<div class="space-y-6">
    <h1 class="text-3xl font-semibold">Your posts</h1>
    @if (Model.StatusMessage is not null) { <p class="alert" role="status">@Model.StatusMessage</p> }
    @if (Model.Site.RecoveryError is not null) { <p class="alert" role="alert">@Model.Site.RecoveryError</p> }
    <div class="flex flex-wrap gap-2">
        @foreach (var type in Model.EnabledPostTypes)
        { <form method="post" asp-page-handler="New"><input type="hidden" name="type" value="@type" /><button class="btn">New @(type switch { Homestead.Data.Entities.PostType.Microblog => "note", Homestead.Data.Entities.PostType.Checkin => "check-in", Homestead.Data.Entities.PostType.Fitness => "fitness activity", _ => type.ToString().ToLowerInvariant() })</button></form> }
        <form method="post" asp-page-handler="Rebuild"><button class="btn">Rebuild site</button></form>
        <a class="btn" href="/">View public site</a>
    </div>
    <nav class="flex flex-wrap gap-2" aria-label="Post filters">
        <a class="btn" href="/admin/posts">All</a>
        <a class="btn" href="/admin/posts?scheduled=true">Scheduled</a>
        @foreach (var status in new[] { "Draft", "Published", "Unpublished" })
        { <a class="btn" href="/admin/posts?status=@status">@status</a> }
    </nav>
    @if (Model.EnabledPostTypes.Length == 0) { <p>Enable a post type in <a class="link" href="/admin/settings#posts">Settings</a> to start writing.</p> }
    else if (Model.Posts.Count == 0) { <p>No posts here yet. Choose a post type to start.</p> }
    @foreach (var post in Model.Posts)
    {
        var live = Model.Site.Current?.Articles.SingleOrDefault(x => x.PostId == post.Id);
        var pending = Homestead.Features.Articles.ArticleService.IsPublicationPending(post, live);
        <article class="border border-base-300 rounded-lg p-4 space-y-2">
            <h2 class="text-xl font-semibold"><a href="/admin/posts/@post.Id/edit">@Homestead.Pages.Admin.Posts.IndexModel.DraftTitle(post)</a></h2>
            <p>@(post.Type == Homestead.Data.Entities.PostType.Checkin ? "Check-in" : post.Type == Homestead.Data.Entities.PostType.Fitness ? "Fitness activity" : post.Type.ToString()) · @post.Status · @(live is null ? "Not currently public" : "Currently public")</p>
            @if (post.Schedule is { } schedule)
            {
                <p>Scheduled for <time datetime="@schedule.PublishAtUtc.ToString("O")">@DateDisplay.Timestamp(schedule.PublishAtUtc, Model.TimeZone)</time></p>
                @if (schedule.Error is not null) { <p role="status">@schedule.Error Next check: @DateDisplay.Timestamp(schedule.NextAttemptAtUtc, Model.TimeZone)</p> }
            }
            <p class="text-sm">Updated <time datetime="@post.UpdatedAtUtc.ToString("O")" title="@DateDisplay.Timestamp(post.UpdatedAtUtc, Model.TimeZone)" aria-label="@DateDisplay.Timestamp(post.UpdatedAtUtc, Model.TimeZone)">@DateDisplay.Relative(post.UpdatedAtUtc)</time></p>
            @if (live is not null && Homestead.Features.Articles.ArticleService.HasDraftChanges(post, live)) { <p>Unpublished edits</p> }
            @if (pending) { <p role="status">Publication pending. @(live is not null ? "The previous post is still public." : "This post is not public.") Rebuild to apply saved changes.</p> }
        </article>
    }
    @if (Model.Site.Current is { } generation)
    {
        <p class="text-sm">Last successful build: <time datetime="@generation.ActivatedAtUtc.ToString("O")" title="@DateDisplay.Timestamp(generation.ActivatedAtUtc, Model.TimeZone)" aria-label="@DateDisplay.Timestamp(generation.ActivatedAtUtc, Model.TimeZone)">@DateDisplay.Relative(generation.ActivatedAtUtc)</time></p>
    }
</div>
