@page "/admin/analytics"
@model Homestead.Pages.Admin.AnalyticsModel
@{ ViewData["Title"] = "Analytics"; }
<div class="space-y-6">
    <h1 class="text-3xl font-semibold">Analytics</h1>
    @if (Model.StatusMessage is not null) { <p class="alert" role="status">@Model.StatusMessage</p> }
    <form method="post" class="space-y-4">
        <label class="flex items-center gap-3 min-h-11"><input asp-for="Enabled" class="toggle" /> Count public page views</label>
        <p id="analytics-description">Off by default. Counts successful anonymous HTML page requests, excluding logged-in visitors and obvious bots and AI agents. Bot filtering uses user agents and is best effort.</p>
        <p>No cookies or visitor identifiers are used. Only page paths and all-time counters are stored. Repeat visits count again; these are page views, not unique visitors. Disabling retains existing counts.</p>
        <button class="btn" type="submit">Save analytics settings</button>
    </form>
    <div class="stats border border-base-300">
        <div class="stat"><div class="stat-title">Total page views</div><div class="stat-value">@Model.TotalHits.ToString("N0")</div><div class="stat-desc">All time · @(Model.Enabled ? "Tracking enabled" : "Tracking disabled")</div></div>
    </div>
    <section class="space-y-4" aria-labelledby="pages-heading">
        <h2 id="pages-heading" class="text-xl font-semibold">Views per page</h2>
        @if (Model.Pages.Count == 0)
        {
            <p>No page views recorded yet.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="table">
                    <caption class="sr-only">All-time views per public page, most viewed first</caption>
                    <thead><tr><th scope="col">Page</th><th scope="col">Views</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Pages)
                        {
                            <tr><th scope="row" class="break-all whitespace-normal">@item.Path</th><td>@item.Hits.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="flex flex-wrap items-center gap-3" aria-label="Analytics pages">
                @if (Model.PageNumber > 1) { <a class="btn" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a> }
                <span>Page @Model.PageNumber of @Model.TotalPages</span>
                @if (Model.PageNumber < Model.TotalPages) { <a class="btn" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a> }
            </nav>
        }
    </section>
</div>
