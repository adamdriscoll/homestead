@page "/admin/settings"
@model Homestead.Pages.Admin.SettingsModel
@{ ViewData["Title"] = "Settings"; }
<section class="space-y-6" data-settings>
    <div class="space-y-2">
        <h1 class="text-3xl font-semibold">Settings</h1>
        <p>Make this place yours. Saving rebuilds your public site.</p>
    </div>
    @if (Model.StatusMessage != null) { <div class="alert" role="status">@Model.StatusMessage</div> }
    <div class="grid gap-6 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8">
        <nav aria-label="Settings sections" data-settings-navigation>
            <ul class="menu menu-horizontal md:menu-vertical bg-base-200 rounded-box w-full p-2">
                @foreach (var (label, icon) in new[] { ("General", "gear"), ("Posts", "pen"), ("Social", "share-nodes"), ("Theme", "palette"), ("About", "user"), ("Images", "images"), ("Newsletter", "gear"), ("Backup", "gear") })
                {
                    <li>
                        <a id="tab-@label.ToLowerInvariant()" href="#@label.ToLowerInvariant()" class="min-h-11 content-center px-2 md:px-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content" data-settings-tab>
                            <svg class="size-4 fill-current" viewBox="0 0 640 640" aria-hidden="true" focusable="false"><use href="/icons/toolbar.svg#@icon"></use></svg>
                            <span>@label</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
        <div class="min-w-0 space-y-6">
            <form method="post" id="settings-form" class="space-y-6">
                <input asp-for="Section" type="hidden" />
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" role="alert" class="text-error"></div>
                }
                <section id="general" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="general-title" data-settings-panel>
                    <h2 id="general-title" class="text-xl font-semibold">General</h2>
                    <p>Your site’s name, address, and time zone.</p>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Your site</legend>
                        <label asp-for="Input.Title"></label><input asp-for="Input.Title" class="input w-full" />
                        <label asp-for="Input.CanonicalBaseUrl"></label><input asp-for="Input.CanonicalBaseUrl" type="url" class="input w-full" />
                        <label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="textarea w-full" rows="3"></textarea>
                        <label asp-for="Input.TimeZone"></label><input asp-for="Input.TimeZone" class="input w-full" list="timezones" />
                        <datalist id="timezones">@foreach (var zone in TimeZoneInfo.GetSystemTimeZones()) { <option value="@zone.Id">@zone.DisplayName</option> }</datalist>
                    </fieldset>
                </section>
                <section id="posts" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="posts-title" data-settings-panel>
                    <h2 id="posts-title" class="text-xl font-semibold">Posts</h2>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Post types</legend>
                        <p>Choose the types you use. Disabled types are hidden from your dashboard, post list, and public site after a successful rebuild. Posts and photos are kept; re-enable a type to show them again.</p>
                        <div class="grid gap-0">
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableNotes" class="checkbox" /> Notes</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableArticles" class="checkbox" /> Articles</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableReviews" class="checkbox" /> Reviews</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableGuides" class="checkbox" /> Guides</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableGalleries" class="checkbox" /> Galleries</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableCheckins" class="checkbox" /> Check-ins</label>
                        </div>
                    </fieldset>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Location map</legend>
                        <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.EnableLocationMap" class="checkbox" aria-describedby="location-map-help" /> Enable location map</label>
                        <p id="location-map-help">Add a public world map linking to posts with published latitude and longitude. Locations with only a name or address do not appear. Draft locations stay private.</p>
                    </fieldset>
                </section>
                <section id="social" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="social-title" data-settings-panel>
                    <h2 id="social-title" class="text-xl font-semibold">Social</h2>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Social sharing</legend>
                        <p>Choose the sharing buttons shown on public posts and feed cards. Leave all unchecked to hide sharing buttons. Private previews never show them.</p>
                        <div class="grid gap-0">
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.ShareBluesky" class="checkbox" /> Bluesky</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.ShareFacebook" class="checkbox" /> Facebook</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.ShareX" class="checkbox" /> X</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.ShareLinkedIn" class="checkbox" /> LinkedIn</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.ShareReddit" class="checkbox" /> Reddit</label>
                            <label class="flex items-center gap-3 min-h-11"><input asp-for="Input.ShareEmail" class="checkbox" /> Email</label>
                        </div>
                        <p>Buttons open ordinary links to the selected service or email app. Sharing uses the public post’s title and canonical URL.</p>
                    </fieldset>
                </section>
                <section id="theme" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="theme-title" data-settings-panel>
                    <h2 id="theme-title" class="text-xl font-semibold">Theme</h2>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Public theme</legend>
                        <p>Porch is a familiar feed, Journal focuses on reading, Ledger uses a wider magazine layout, and Folio pairs a bold cover with spacious reading layouts. Administration keeps its own light/dark appearance.</p>
                        <label asp-for="Input.ThemeId"></label>
                        <select asp-for="Input.ThemeId" class="select w-full">
                            @foreach (var theme in Model.Themes) { <option value="@theme.Id">@theme.Name · @theme.Version @(theme.SupportsColors ? "· colors supported" : "")</option> }
                        </select>
                        <p>Currently public: @(Model.ActiveTheme?.Name ?? "Porch") @(Model.ActiveTheme?.Version). Saving applies your selection after a successful rebuild.</p>
                        <label asp-for="Input.AccentColor"></label><select asp-for="Input.AccentColor" class="select w-full">@foreach (var accent in Homestead.Features.Settings.SettingsInput.Accents) { <option>@accent</option> }</select>
                        <p>Optional colors override theme defaults when the theme supports colors. Leave blank to reset; use #RRGGBB. Choose readable text and background combinations in both light and dark mode.</p>
                        <label asp-for="Input.ThemePrimaryColor"></label><input asp-for="Input.ThemePrimaryColor" class="input w-full" placeholder="#25613e" maxlength="7" />
                        <label asp-for="Input.ThemeBackgroundColor"></label><input asp-for="Input.ThemeBackgroundColor" class="input w-full" placeholder="#ffffff" maxlength="7" />
                        <label asp-for="Input.ThemeTextColor"></label><input asp-for="Input.ThemeTextColor" class="input w-full" placeholder="#181818" maxlength="7" />
                    </fieldset>
                    <section class="space-y-3 border-t border-base-300 pt-4" aria-labelledby="themes-title">
                        <h3 id="themes-title" class="font-semibold">Install a custom public theme</h3>
                        <p>Save settings before uploading. Theme ZIPs may include public JavaScript and Razor code that runs on your server with access to application data. Install only themes from authors you trust. Up to 5 MB.</p>
                        <label class="block" for="theme-upload">Theme ZIP</label><input id="theme-upload" name="Upload" form="theme-upload-form" type="file" accept=".zip,application/zip" class="file-input w-full" />
                        <button type="submit" form="theme-upload-form" class="btn">Install theme</button>
                    </section>
                </section>
                <section id="about" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="about-title" data-settings-panel>
                    <h2 id="about-title" class="text-xl font-semibold">About</h2>
                    <p>Introduce yourself and add links to your other profiles.</p>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">About you</legend>
                        <label asp-for="Input.DisplayAuthor"></label><input asp-for="Input.DisplayAuthor" class="input w-full" />
                        <label asp-for="Input.AuthorBio"></label><textarea asp-for="Input.AuthorBio" class="textarea w-full" rows="3"></textarea>
                        <label asp-for="Input.AboutMarkdown"></label><textarea asp-for="Input.AboutMarkdown" class="textarea w-full" rows="8"></textarea>
                        <label asp-for="Input.FooterText"></label><input asp-for="Input.FooterText" class="input w-full" />
                        <label class="flex items-center gap-3 min-h-11" asp-for="Input.HideHomesteadCredit">
                            <input asp-for="Input.HideHomesteadCredit" class="checkbox" aria-describedby="homestead-credit-help" />
                            Hide Homestead credit
                        </label>
                        <p id="homestead-credit-help">Public pages show “Made at home with Homestead” with a link to the project. Check this to hide it.</p>
                    </fieldset>
                    <fieldset class="fieldset gap-3" data-settings-error="@(ViewData.ModelState.TryGetValue("Input.ProfileLinks", out var profileState) && profileState.Errors.Count > 0 ? "true" : null)">
                        <legend class="fieldset-legend">External profiles (up to five)</legend>
                        @for (var i = 0; i < Model.Input.ProfileLinks.Count; i++)
                        {
                            <label for="profile-label-@i">Profile @(i + 1) label</label><input id="profile-label-@i" asp-for="Input.ProfileLinks[i].Label" class="input w-full" maxlength="80" />
                            <label for="profile-url-@i">Profile @(i + 1) URL</label><input id="profile-url-@i" asp-for="Input.ProfileLinks[i].Url" class="input w-full" type="url" maxlength="2048" />
                        }
                    </fieldset>
                </section>
                <div class="space-y-2">
                    <button type="submit" class="btn btn-primary">Save settings</button>
                    <p class="text-sm">Saves changes in General, Posts, Social, Theme, and About.</p>
                </div>
            </form>
            <form method="post" id="theme-upload-form" asp-page-handler="Theme" enctype="multipart/form-data" hidden></form>
            <section id="newsletter" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="newsletter-title" data-settings-panel>
                <h2 id="newsletter-title" class="text-xl font-semibold">Newsletter</h2>
                <p>Let readers subscribe to new posts through Brevo. Choose a verified sender in your Brevo account and enter an API key with permission to send transactional emails.</p>
                <form method="post" asp-page-handler="Newsletter" class="space-y-4">
                    <div asp-validation-summary="All" role="alert" class="text-error"></div>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Brevo email delivery</legend>
                        <label class="flex items-center gap-3 min-h-11"><input asp-for="Newsletter.Enabled" class="checkbox" /> Enable newsletter subscriptions and delivery</label>
                        <label asp-for="Newsletter.SenderEmail"></label><input asp-for="Newsletter.SenderEmail" type="email" class="input w-full" maxlength="254" />
                        <label asp-for="Newsletter.SenderName"></label><input asp-for="Newsletter.SenderName" class="input w-full" maxlength="120" />
                        <label asp-for="Newsletter.ApiKey">Brevo API key</label><input asp-for="Newsletter.ApiKey" type="password" class="input w-full" autocomplete="new-password" maxlength="1024" />
                        <p>API key saved: @(Model.NewsletterStatus.ProtectedApiKey.Length > 0 ? "Yes" : "No"). Leave blank to retain it. Saved keys are protected and never displayed.</p>
                        <label class="flex items-center gap-3 min-h-11"><input asp-for="Newsletter.ClearApiKey" class="checkbox" /> Clear saved API key</label>
                    </fieldset>
                    <button class="btn" type="submit">Save newsletter settings</button>
                </form>
                <p>Readers confirm their email address, choose instant notices or a weekly summary, and select post types. Emails announce newly public posts; edits do not resend them. Weekly summaries start seven days after confirmation.</p>
                <p>Disabling stops subscriptions and delivery immediately. Existing readers can still unsubscribe. Re-enabling starts with future posts.</p>
                <p>Confirmed subscribers: @Model.SubscriberCount</p>
                <p>Last email accepted (UTC): @(Model.NewsletterStatus.LastSuccessAtUtc?.ToString("u") ?? "Never")</p>
                @if (Model.NewsletterStatus.LastError is { } newsletterError) { <p class="text-error" role="status">@newsletterError</p> }
                @if (Model.Settings.EnableNewsletter) { <a class="link" href="/newsletter/">View subscription page</a> }
            </section>
            <section id="backup" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="backup-title" data-settings-panel>
                <h2 id="backup-title" class="text-xl font-semibold">Backup</h2>
                <p>Upload complete backups to a private S3-compatible bucket. Archives include drafts, originals, administrator credentials, and encryption keys. Configure bucket encryption and retention with your storage provider.</p>
                <form method="post" asp-page-handler="Backup" class="space-y-4">
                    <div asp-validation-summary="All" role="alert" class="text-error"></div>
                    <fieldset class="fieldset gap-3">
                        <legend class="fieldset-legend">Automated backups</legend>
                        <label class="flex items-center gap-3 min-h-11"><input asp-for="Backup.Enabled" class="checkbox" /> Enable automated backups</label>
                        <label asp-for="Backup.Frequency"></label>
                        <select asp-for="Backup.Frequency" class="select w-full">
                            <option value="BeforePublication">Before publishing a new version of the site</option>
                            <option value="Daily">Once a day</option>
                            <option value="Weekly">Once a week</option>
                        </select>
                        <p>Daily and weekly backups start when next checked, then run 24 hours or seven days after the last successful upload. Missed backups run after restart. A failed before-publication backup leaves saved changes pending and the previous site active.</p>
                        <label asp-for="Backup.Endpoint"></label><input asp-for="Backup.Endpoint" class="input w-full" type="url" placeholder="https://s3.example.com" />
                        <p>Leave the endpoint blank for Amazon S3. Use an HTTPS service endpoint for compatible storage.</p>
                        <label asp-for="Backup.Region"></label><input asp-for="Backup.Region" class="input w-full" />
                        <label asp-for="Backup.Bucket"></label><input asp-for="Backup.Bucket" class="input w-full" />
                        <label asp-for="Backup.Prefix"></label><input asp-for="Backup.Prefix" class="input w-full" />
                        <label class="flex items-center gap-3 min-h-11"><input asp-for="Backup.ForcePathStyle" class="checkbox" /> Use path-style bucket URLs</label>
                        <label asp-for="Backup.AccessKey"></label><input asp-for="Backup.AccessKey" class="input w-full" type="password" autocomplete="new-password" />
                        <label asp-for="Backup.SecretKey"></label><input asp-for="Backup.SecretKey" class="input w-full" type="password" autocomplete="new-password" />
                        <p>Credentials saved: @(Model.BackupStatus.ProtectedAccessKey.Length > 0 && Model.BackupStatus.ProtectedSecretKey.Length > 0 ? "Yes" : "No"). Leave credential fields blank to retain them. Saved values are protected and never displayed.</p>
                        <label class="flex items-center gap-3 min-h-11"><input asp-for="Backup.ClearCredentials" class="checkbox" /> Clear saved credentials</label>
                    </fieldset>
                    <button class="btn" type="submit">Save backup settings</button>
                </form>
                <div class="space-y-2">
                    <p>Last attempt (UTC): @(Model.BackupStatus.LastAttemptAtUtc?.ToString("u") ?? "Never")</p>
                    <p>Last successful upload (UTC): @(Model.BackupStatus.LastSuccessAtUtc?.ToString("u") ?? "Never")</p>
                    @if (Model.BackupStatus.LastObjectKey is { } key) { <p class="break-all">Last object: @key</p> }
                    @if (Model.BackupStatus.LastError is { } error) { <p class="text-error">@error</p> }
                </div>
                <form method="post" asp-page-handler="BackupNow"><button class="btn" type="submit">Back up now</button></form>
                <p>Save backup settings first. Back up now uses the saved configuration when enabled. Uploads can delay authoring; public pages remain available.</p>
            </section>
            <section id="images" class="space-y-4 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content" aria-labelledby="images-title" data-settings-panel>
                <h2 id="images-title" class="text-xl font-semibold">Images</h2>
                <p>Upload your avatar, logo, and header. Save changes in the other sections before uploading. JPEG, PNG, or WebP, up to 20 MB.</p>
                @foreach (var (slot, id) in new[] { ("Avatar", Model.Settings.AvatarMediaId), ("Logo", Model.Settings.LogoMediaId), ("Header", Model.Settings.HeaderMediaId) })
                {
                    <div class="space-y-3 border border-base-300 rounded-lg p-4">
                        <h3 class="font-semibold">@slot</h3>
                        @if (id is not null) { <img src="/admin/media/@id" alt="Current @slot" class="max-w-full max-h-32" /> }
                        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="space-y-3">
                            <input type="hidden" name="Slot" value="@slot" />
                            <label class="block" for="upload-@slot">New @slot image</label><input id="upload-@slot" name="Upload" type="file" accept="image/jpeg,image/png,image/webp" class="file-input w-full" />
                            <button class="btn">Upload @slot</button>
                        </form>
                        @if (id is not null)
                        { <form method="post" asp-page-handler="Remove"><input type="hidden" name="Slot" value="@slot" /><button class="btn">Remove @slot</button></form> }
                    </div>
                }
            </section>
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true" defer></script>
}
