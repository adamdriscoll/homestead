<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Homestead</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <script src="~/js/admin-appearance.js" asp-append-version="true"></script>
    <script src="~/js/admin-navigation.js" asp-append-version="true" defer></script>
</head>
<body>
    <a href="#main" class="btn absolute -top-20 focus:top-2 left-2">Skip to content</a>
    <header class="border-b border-base-300">
        <div class="max-w-5xl mx-auto p-4 flex items-center justify-between gap-4">
            <a href="/admin" class="text-xl font-semibold">Homestead</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var administratorName = string.IsNullOrWhiteSpace(User.Identity.Name) ? "Administrator" : User.Identity.Name;
                var initial = System.Globalization.StringInfo.GetNextTextElement(administratorName).ToUpperInvariant();
                var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                <details class="dropdown dropdown-end" data-admin-menu>
                    <summary class="btn btn-circle btn-ghost p-0" aria-label="Account menu" title="Account menu">
                        <span class="avatar avatar-placeholder" aria-hidden="true">
                            <span class="flex items-center justify-center bg-neutral text-neutral-content rounded-full size-11 font-semibold">@initial</span>
                        </span>
                    </summary>
                    <div class="dropdown-content bg-base-100 border border-base-300 rounded-2xl shadow-xl z-50 mt-3 w-80 max-w-[calc(100vw-2rem)] p-2">
                        <div class="flex items-center gap-3 px-3 py-4 border-b border-base-300">
                            <div class="avatar avatar-placeholder shrink-0" aria-hidden="true">
                                <div class="bg-neutral text-neutral-content rounded-full size-11 font-semibold">@initial</div>
                            </div>
                            <div class="min-w-0">
                                <p class="font-semibold break-all">@administratorName</p>
                                <p class="text-sm text-base-content/60">Administrator</p>
                            </div>
                        </div>
                        <nav aria-label="Administration">
                            @foreach (var group in new[] {
                                new[] { ("/Admin/Index", "Dashboard", "house"), ("/Admin/Posts/Index", "Posts", "pen") },
                                new[] { ("/Admin/Settings", "Settings", "gear"), ("/Admin/Maintenance", "Maintenance", "screwdriver-wrench") }
                            })
                            {
                                <ul class="menu w-full py-2 border-b border-base-300">
                                    @foreach (var (route, label, icon) in group)
                                    {
                                        var active = currentPage == route || (route == "/Admin/Posts/Index" && currentPage.StartsWith("/Admin/Posts/", StringComparison.Ordinal));
                                        <li>
                                            <a asp-page="@route" class="min-h-11 content-center @(active ? "bg-base-200 text-base-content font-medium" : "")" aria-current="@(active ? "page" : null)">
                                                <svg class="size-4 fill-current text-base-content/60" viewBox="0 0 640 640" aria-hidden="true" focusable="false"><use href="/icons/toolbar.svg#@icon"></use></svg>
                                                <span>@label</span>
                                                <svg class="size-3 fill-current text-base-content/40 ml-auto" viewBox="0 0 640 640" aria-hidden="true" focusable="false"><use href="/icons/toolbar.svg#chevron-right"></use></svg>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                            <ul class="menu w-full py-2 border-b border-base-300">
                                <li>
                                    <a href="/" class="min-h-11 content-center">
                                        <svg class="size-4 fill-current text-base-content/60" viewBox="0 0 640 640" aria-hidden="true" focusable="false"><use href="/icons/toolbar.svg#eye"></use></svg>
                                        <span>View public site</span>
                                        <svg class="size-3 fill-current text-base-content/40 ml-auto" viewBox="0 0 640 640" aria-hidden="true" focusable="false"><use href="/icons/toolbar.svg#chevron-right"></use></svg>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <div class="flex flex-wrap items-center justify-between gap-2 px-2 py-3">
                            <partial name="_AdminAppearance" />
                            <form method="post" asp-page="/Account/Logout">
                                <button class="btn btn-outline btn-error min-h-11 px-3" type="submit">
                                    <svg class="size-4 fill-current" viewBox="0 0 640 640" aria-hidden="true" focusable="false"><use href="/icons/toolbar.svg#right-from-bracket"></use></svg>
                                    Sign out
                                </button>
                            </form>
                        </div>
                    </div>
                </details>
            }
            else
            {
                <partial name="_AdminAppearance" />
            }
        </div>
    </header>
    <main id="main" class="max-w-5xl mx-auto px-4 py-8">@RenderBody()</main>
    <footer class="max-w-5xl mx-auto p-4 text-sm border-t border-base-300">Your home on the internet.</footer>
</body>
@await RenderSectionAsync("Scripts", required: false)
</html>
